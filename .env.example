# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real keys.

# Google Gemini API key, used by run_pipeline.py locally.
# Get a free key (no credit card required) at https://aistudio.google.com/apikey
GOOGLE_API_KEY=AIza...

# Published Google Sheet CSV export URL (File > Share > Publish to web > CSV).
# This is the client's live activity ledger, fetched at query time.
CLIENT_SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/e/YOUR_PUBLISHED_ID/pub?output=csv
